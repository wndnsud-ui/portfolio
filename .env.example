DATABASE_URL=sqlite:///./decisionflow.db
APP_ENV=development
ATTACHMENT_DIR=data/attachments
# Keep encryption/signing keys stable across redeploys.
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8001/api/auth/kakao/callback
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:8001
# Password reset email (Gmail: use an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
# Docker Compose PostgreSQL settings
POSTGRES_DB=decisionflow
POSTGRES_USER=decisionflow
POSTGRES_PASSWORD=change-me
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
DIARIZATION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_CONCURRENCY=3
FFMPEG_PATH=
DECISION_ANALYSIS_MODEL=gpt-4o-mini
# Reads text from meeting photos; use a larger vision model (e.g. gpt-4o) for messy handwriting.
IMAGE_TEXT_MODEL=gpt-4o-mini
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_API_VERSION=2026-03-11
SECRET_KEY=change-me
ML_MODEL_PATH=app/ml/models/delay_risk.joblib
