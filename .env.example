# 이 파일은 키 이름만 적는다. 실제 값은 ~/Desktop/프로젝트/포트폴리오/env.txt(로컬, iCloud 밖)나 Railway 환경변수에 넣는다.

# 세션 서명 키. 아래 명령으로 만든다: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 관리자 1명. 해시는 `flask hash-password`로 만든다 (비밀번호 원문은 어디에도 저장하지 않는다)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Supabase › Connect › Session pooler (포트 5432). 비우면 로컬 SQLite(instance/portfolio.db)를 쓴다
DATABASE_URL=

# Supabase Storage (퍼블릭 버킷 media). 비우면 이미지를 static/uploads/에 저장한다
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# 배포 환경에서만 1 (HTTPS에서만 세션 쿠키 전송)
SESSION_COOKIE_SECURE=0

# 카카오 책 검색 — 독서 노트에서 표지·저자·출판사 자동 채우기. developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=

# 노션 독서 DB 동기화. notion.so/profile/integrations → 내부 통합 → 시크릿. DB의 ··· › 연결에 그 통합을 추가한다
NOTION_TOKEN=
# 독서 DB 주소(그대로 붙여 넣어도 된다)
NOTION_READING_DB=

# 배포 주소 (sitemap·RSS·공유 미리보기에 쓴다). 예: https://hy-archive.up.railway.app
SITE_URL=
