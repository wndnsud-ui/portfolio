# ───────── Backend ─────────
# 비워두면 backend/data/dev.db (SQLite)로 동작. 운영: Supabase Postgres 연결 문자열
DATABASE_URL=
SUPABASE_URL=
# Backend 전용. Frontend에 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 레거시 HS256 프로젝트만 필요. 비대칭 키(JWKS) 프로젝트는 비워둔다.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=episodes
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe-diarize
OPENAI_LLM_MODEL=gpt-4.1
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=5400
STT_CHUNK_SEC=1200
STT_OVERLAP_SEC=15
CORS_ORIGINS=http://localhost:5173
# 로컬 Storage 서명 URL의 기준 주소 (Supabase Storage를 쓰면 무시)
PUBLIC_API_BASE_URL=http://localhost:8000

# 개발 모드 — 운영에서는 반드시 false
DEV_AUTH_ENABLED=false
# auto: OPENAI_API_KEY가 있으면 openai, 없으면 mock
STT_PROVIDER=auto
LLM_PROVIDER=auto

# AI 시작음 (비우면 합성 차임으로 동작)
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v1
INTRO_PROVIDER=auto

# ───────── Frontend (VITE_ 접두사) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# 카카오 REST API 키와 Client Secret은 Supabase 대시보드에만 입력한다. 이 파일에 넣지 않는다.
